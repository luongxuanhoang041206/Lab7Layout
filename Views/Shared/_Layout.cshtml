<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f2ec" />
    <title>@ViewData["Title"] - Bistup</title>
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="announcement-bar">Thoughtful things for the everyday · Complimentary delivery over $75</div>
    <header class="store-header">
        <nav class="navbar navbar-expand-lg container-xl py-3" aria-label="Main navigation">
            <a class="navbar-brand store-brand" asp-area="" asp-controller="LXHHome" asp-action="Index">bistup<span>.</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#storeNavigation"
                    aria-controls="storeNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="storeNavigation">
                <ul class="navbar-nav mx-auto gap-lg-3">
                    <li class="nav-item"><a class="nav-link" href="/#collection">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#story">Our story</a></li>
                    <li class="nav-item"><a class="nav-link" href="/#journal">Journal</a></li>
                </ul>
                <a class="btn btn-outline-dark rounded-pill px-4" asp-area="Admin" asp-controller="LXHDashboard" asp-action="Index">
                    <i class="fas fa-sliders-h me-2"></i>Admin
                </a>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="store-footer">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between gap-3">
            <a class="store-brand text-white" asp-area="" asp-controller="LXHHome" asp-action="Index">bistup<span>.</span></a>
            <p class="mb-0">Objects made to be lived with. © @DateTime.Now.Year Bistup Studio.</p>
            <a class="footer-admin-link" asp-area="Admin" asp-controller="LXHDashboard" asp-action="Index">Store administration</a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
