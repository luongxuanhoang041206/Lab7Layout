@model IEnumerable<Banner>
@{
    ViewData["Title"] = "Banner";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">Banner</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="LXHDashboard" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Banner</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title">Danh sách banner</h3>
                <a class="btn btn-primary btn-sm" asp-action="Create"><i class="fas fa-plus mr-1"></i> Thêm banner</a>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Banner</th>
                            <th>Thứ tự</th>
                            <th>Trạng thái</th>
                            <th>Mô tả</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var banner in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(banner.Image))
                                    {
                                        <img class="admin-thumbnail mr-2" src="@banner.Image" alt="" />
                                    }
                                    @banner.Name
                                </td>
                                <td>@banner.Priority</td>
                                <td><span class="badge badge-@(banner.Status == 1 ? "success" : "secondary")">@(banner.Status == 1 ? "Hiển thị" : "Ẩn")</span></td>
                                <td>@banner.Description</td>
                                <td class="text-right">
                                    <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@banner.Id"><i class="fas fa-pen"></i> Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@banner.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa banner này?');">
                                        <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fas fa-trash"></i> Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted p-4">Chưa có banner nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
