@{
    ViewData["Title"] = "Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Dashboard</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active">Dashboard v1</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>@ViewData["ProductCount"]</h3>
                        <p>Sản phẩm</p>
                    </div>
                    <div class="icon"><i class="fas fa-box-open"></i></div>
                    <a asp-area="Admin" asp-controller="LXHProduct" asp-action="Index" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>@ViewData["CategoryCount"]</h3>
                        <p>Danh mục</p>
                    </div>
                    <div class="icon"><i class="fas fa-tags"></i></div>
                    <a asp-area="Admin" asp-controller="LXHCategory" asp-action="Index" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>@ViewData["BannerCount"]</h3>
                        <p>Banner</p>
                    </div>
                    <div class="icon"><i class="far fa-images"></i></div>
                    <a asp-area="Admin" asp-controller="LXHBanner" asp-action="Index" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>@ViewData["BlogCount"]</h3>
                        <p>BLogs</p>
                    </div>
                    <div class="icon"><i class="fas fa-feather-alt"></i></div>
                    <a asp-area="Admin" asp-controller="LXHBlog" asp-action="Index" class="small-box-footer">
                        More info <i class="fas fa-arrow-circle-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
