@model IEnumerable<Category>
@{
    ViewData["Title"] = "Danh mục";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6"><h1 class="m-0">Danh mục</h1></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="LXHDashboard" asp-action="Index">Home</a></li>
                    <li class="breadcrumb-item active">Danh mục</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <h3 class="card-title">Danh sách danh mục</h3>
                <a class="btn btn-primary btn-sm" asp-action="Create"><i class="fas fa-plus mr-1"></i> Thêm danh mục</a>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Tên</th>
                            <th>Ảnh</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th>Ngày tạo</th>
                            <th class="text-right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var category in Model)
                        {
                            <tr>
                                <td>@category.Name</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(category.Image))
                                    {
                                        <img class="admin-thumbnail" src="@category.Image" alt="@category.Name" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@(category.Description ?? "—")</td>
                                <td><span class="badge badge-@(category.Status == 1 ? "success" : "secondary")">@(category.Status == 1 ? "Hiển thị" : "Ẩn")</span></td>
                                <td>@category.CreatedDate.ToLocalTime().ToString("d")</td>
                                <td class="text-right">
                                    <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@category.Id"><i class="fas fa-pen"></i> Sửa</a>
                                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa danh mục này?');">
                                        <button class="btn btn-outline-danger btn-sm" type="submit"><i class="fas fa-trash"></i> Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted p-4">Chưa có danh mục nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
